# Copy this file to .env and paste your real keys in.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# .env is git-ignored. This template is committed so anyone cloning the repo
# knows which keys the project needs.

# Primary provider. Free tier: https://console.groq.com/keys
#
# Supports a POOL of keys, comma-separated, no spaces needed either side:
#   GROQ_API_KEY=key1,key2,key3
# Failover is STICKY, not round-robin: key1 is used for every call until it
# fails (429, 5xx, or connection/timeout — never on 400), then key2, and so on.
# Only once every Groq key has failed does the client cross to Cerebras. A
# single key is still valid input — just don't add a trailing comma.
GROQ_API_KEY=

# Fallback provider — same pool format, same sticky rule, reached only after
# every Groq key in the pool has failed. Free tier: https://cloud.cerebras.ai
# A multi-agent run makes 8-15 LLM calls per question, so free-tier limits are a
# real constraint here, not a theoretical one — the pool exists to stretch that
# quota before spending the failover tier at all.
CEREBRAS_API_KEY=

# Semantic cache. Default matches the docker-compose service.
REDIS_URL=redis://localhost:6379
